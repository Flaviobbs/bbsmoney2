{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ohcbprzrifyvabhknxlq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "bbsmoney-mcp",
      "version": "0.1.0",
      "title": "BBSMoney"
    },
    "tools": [
      {
        "name": "list_transactions",
        "title": "Listar transações",
        "description": "Lista transações financeiras do usuário autenticado, com filtros opcionais por período, tipo e limite. Datas no formato AAAA-MM-DD.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date_from": {
              "description": "Data inicial AAAA-MM-DD (opcional).",
              "type": "string"
            },
            "date_to": {
              "description": "Data final AAAA-MM-DD (opcional).",
              "type": "string"
            },
            "type": {
              "description": "Filtrar por tipo.",
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "limit": {
              "description": "Máximo de resultados (padrão 100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Criar transação",
        "description": "Cria uma transação (receita ou despesa) para o usuário autenticado. Se category_id não for informado, tenta casar pelo nome em category_name.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Descrição da transação."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Valor em reais, sempre positivo."
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ],
              "description": "Tipo da transação."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data no formato AAAA-MM-DD."
            },
            "category_id": {
              "description": "ID da categoria (opcional).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "category_name": {
              "description": "Nome da categoria (usado se category_id ausente).",
              "type": "string"
            },
            "merchant": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "description",
            "amount",
            "type",
            "date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "Listar categorias",
        "description": "Lista as categorias (e subcategorias) do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "type": {
              "description": "Filtrar por tipo.",
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "monthly_summary",
        "title": "Resumo mensal",
        "description": "Retorna totais de receitas, despesas, saldo e top categorias de despesa no período informado (padrão: mês corrente).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "period_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "period_end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
